# =============================================================================
# CLIProxyAPI ENVIRONMENT TEMPLATE (portainer.env.example)
# HUONG DAN:
#   1. Copy tep nay thanh `portainer.env`:
#        Copy-Item portainer.env.example portainer.env
#   2. Dien cac gia tri bi mat (DOCKERHUB_TOKEN, PORTAINER_ACCESS_TOKEN, MANAGEMENT_PASSWORD).
#   3. TUYET DOI KHONG commit `portainer.env` len Git (da duoc .gitignore chan).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CONG DICH VU & DINH DANH CONTAINER
# -----------------------------------------------------------------------------
CLIPROXY_PORT=8317
CLIPROXY_OAUTH_GEMINI_PORT=8085
CLIPROXY_OAUTH_CODEX_PORT=1455
CLIPROXY_OAUTH_CLAUDE_PORT=54545
CLIPROXY_OAUTH_ANTIGRAVITY_PORT=51121
CLIPROXY_OAUTH_IFLOW_PORT=11451

CONTAINER_PREFIX=cli-proxy-api
VOLUME_PREFIX=cliproxyapi
TIMEZONE=Asia/Ho_Chi_Minh

# -----------------------------------------------------------------------------
# 2. MANAGEMENT WEB UI & STORAGE (TUI CHON)
# -----------------------------------------------------------------------------
# Mat khau quan tri cho /management.html va /v8/management (khuyen nghi dat manh khi deploy server)
MANAGEMENT_PASSWORD=
DEPLOY=

# Postgres / Git / Object store (chi dien neu khong dung file local)
# PGSTORE_DSN=
# GITSTORE_GIT_URL=
# OBJECTSTORE_ENDPOINT=

# -----------------------------------------------------------------------------
# 3. DOCKERHUB REPOSITORY & IMAGE (DEPLOY-ONLY)
# -----------------------------------------------------------------------------
DOCKER_IMAGE_REPO=dungnt118/freepbx
DOCKER_IMAGE_TAG=cli-proxy-api
DOCKER_IMAGE=dungnt118/freepbx:cli-proxy-api
DOCKERHUB_USERNAME=dungnt118
# DockerHub Personal Access Token (Read & Write) — chi dung o may local khi push/pull
DOCKERHUB_TOKEN=

# -----------------------------------------------------------------------------
# 4. PORTAINER PRODUCTION DEPLOYMENT API (DEPLOY-ONLY)
# -----------------------------------------------------------------------------
PORTAINER_URL=https://portainer.demego.vn
# Portainer API Access Token — chi dung o may local khi goi Portainer REST API
PORTAINER_ACCESS_TOKEN=
PORTAINER_ENDPOINT_ID=3
# De trong PORTAINER_STACK_ID neu muon script tu tim theo PORTAINER_STACK_NAME hoac tao moi stack
PORTAINER_STACK_ID=
PORTAINER_STACK_NAME=cli-proxy-api
